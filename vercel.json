{
  "buildCommand": "",
  "outputDirectory": ".",
  "framework": null,
  "crons": [
    { "path": "/api/reconcile", "schedule": "*/15 * * * *" }
  ],
  "headers": [
    { "source": "/(.*).html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
