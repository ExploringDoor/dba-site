rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // All parent-facing access goes through the server (/api/*), which signs in as
    // ONE dedicated admin user. Browsers never read/write Firestore directly, so we
    // lock everything to that admin user — registrant PII is never publicly readable.

    function signedIn() { return request.auth != null; }
    function adminDoc() { return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data; }
    function isSuper() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminDoc().active == true
        && adminDoc().role == 'super';
    }

    // Registrations: admin-only, both read and write.
    match /registrations/{id} {
      allow read, write: if isSuper();
    }

    // The admins collection: readable only by an admin (used by the rules themselves).
    match /admins/{uid} {
      allow read: if isSuper();
      allow write: if false; // manage admins from the Firebase console
    }

    // Everything else: denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
